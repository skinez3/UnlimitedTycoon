local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")

local Player = Players.LocalPlayer
local Character = script.Parent
local Humanoid = Character:WaitForChild("Humanoid")
local Animator = Humanoid:WaitForChild("Animator")

local MeleeHitEvent = ReplicatedStorage:WaitForChild("MeleeHit")

local CurrentTool = nil
local WeaponConfig = nil
local Connections = {}
local Tracks = {}

-- Variables for combos and attacks
local LastClickTime = 0
local CurrentAttackName = nil
local IsSwinging = false
local HitTargets = {} -- Who already received damage from the current swing
local CooldownTask = nil

local function PlayDynamicSound(soundConfig, parent)
	if not soundConfig or not soundConfig.Id or not parent then return end

	local sound = Instance.new("Sound")
	sound.SoundId = soundConfig.Id
	sound.Volume = soundConfig.Volume or 0.5

	if soundConfig.PitchRange and #soundConfig.PitchRange == 2 then
		local minPitch = soundConfig.PitchRange[1]
		local maxPitch = soundConfig.PitchRange[2]
		sound.PlaybackSpeed = minPitch + math.random() * (maxPitch - minPitch)
	end

	sound.Parent = parent
	sound:Play()
	Debris:AddItem(sound, 2)
end

local function StopAnimations()
	for _, track in pairs(Tracks) do
		track:Stop()
		track:Destroy()
	end
	Tracks = {}
end

local function OnEquip(tool)
	local configModule = tool:FindFirstChild("WeaponConfig")
	if not configModule then return end

	CurrentTool = tool
	WeaponConfig = require(configModule)
	local handle = tool:FindFirstChild("Handle")
	local charProp = Character:FindFirstChild("CharacterProp")
	if charProp then
		local currentSpeed = charProp:GetAttribute("WalkSpeed") or 16
		charProp:SetAttribute("WalkSpeed", currentSpeed - (WeaponConfig.WalkSpeedPenalty or 0))
	end

	if WeaponConfig.Animations.Idle then
		local anim = Instance.new("Animation")
		anim.AnimationId = WeaponConfig.Animations.Idle
		Tracks.Idle = Animator:LoadAnimation(anim)
		Tracks.Idle:Play()
	end
	
	if handle then
		PlayDynamicSound(WeaponConfig.EquipSound, handle)
	end

	-- CLICK LOGIC (Normal and Double)
	table.insert(Connections, tool.Activated:Connect(function()
		local currentTime = tick()
		local timeSinceLastClick = currentTime - LastClickTime
		LastClickTime = currentTime

		local attackToUse = "Slash"

		-- If clicked quickly and the sword has a lunge - perform a lunge
		if WeaponConfig.Moveset.Lunge and timeSinceLastClick < 0.3 then
			attackToUse = "Lunge"
		end

		-- If we are already swinging with a normal attack, allow it to be interrupted ONLY by a lunge
		if IsSwinging and attackToUse == "Slash" then return end
		if attackToUse == "Lunge" and CurrentAttackName == "Lunge" then return end -- Cannot do a double lunge

		-- Start the attack
		CurrentAttackName = attackToUse
		IsSwinging = true
		HitTargets = {} -- Clear the list of those we have already hit

		local attackData = WeaponConfig.Moveset[attackToUse]
		if not attackData then return end

		-- Stop the previous animation if it's a combo
		if Tracks.Slash and Tracks.Slash.IsPlaying then Tracks.Slash:Stop() end
		if Tracks.Lunge and Tracks.Lunge.IsPlaying then Tracks.Lunge:Stop() end

		-- Load and play the new one
		if not Tracks[attackToUse] then
			local anim = Instance.new("Animation")
			anim.AnimationId = attackData.AnimationId
			local track = Animator:LoadAnimation(anim)
			track.Looped = false
			Tracks[attackToUse] = track
		end
		Tracks[attackToUse]:Play(0.1, 1, attackData.Speed or 1)
		
		if handle then
			PlayDynamicSound(attackData.Sound, handle)
		end
		
		if handle and handle:FindFirstChild("ParticleEmitter2") then
			handle.ParticleEmitter2.Enabled = true
			task.delay(1, function()
				if handle:FindFirstChild("ParticleEmitter2") then
					handle.ParticleEmitter2.Enabled = false
				end
			end)
		end

		-- Forward dash for lunge
		if attackToUse == "Lunge" and attackData.ForwardDash then
			local root = Character:FindFirstChild("HumanoidRootPart")
			if root then
				local bv = Instance.new("BodyVelocity")
				bv.Velocity = root.CFrame.LookVector * attackData.ForwardDash
				bv.MaxForce = Vector3.new(100000, 0, 100000)
				bv.Parent = root
				game:GetService("Debris"):AddItem(bv, 0.2)
			end
		end

		-- Cooldown management
		if CooldownTask then task.cancel(CooldownTask) end
		CooldownTask = task.delay(attackData.Cooldown, function()
			IsSwinging = false
			CurrentAttackName = nil
		end)
	end))

	-- DAMAGE LOGIC
	local handle = tool:FindFirstChild("Handle")
	if handle then
		table.insert(Connections, handle.Touched:Connect(function(hit)
			if not IsSwinging or not CurrentAttackName then return end

			local victimCharacter = hit.Parent
			if victimCharacter == Character then return end

			local victimHumanoid = victimCharacter:FindFirstChild("Humanoid")
			if not victimHumanoid or victimHumanoid.Health <= 0 then return end

			-- Prevent hitting the same enemy twice in one swing
			if HitTargets[victimCharacter] then return end
			HitTargets[victimCharacter] = true 

			local attackerProp = Character:FindFirstChild("CharacterProp")
			local victimProp = victimCharacter:FindFirstChild("CharacterProp")

			if attackerProp and victimProp then
				if attackerProp:GetAttribute("InPVP") and victimProp:GetAttribute("InPVP") then
					-- PASS THE ATTACK NAME TO THE SERVER ("Slash" or "Lunge")
					MeleeHitEvent:FireServer(victimCharacter, CurrentTool, CurrentAttackName)
				end
			end
		end))
	end
end

local function OnUnequip()
	if not CurrentTool then return end

	local charProp = Character:FindFirstChild("CharacterProp")
	if charProp and WeaponConfig then
		local currentSpeed = charProp:GetAttribute("WalkSpeed") or 16
		charProp:SetAttribute("WalkSpeed", currentSpeed + (WeaponConfig.WalkSpeedPenalty or 0))
	end

	for _, conn in ipairs(Connections) do conn:Disconnect() end
	Connections = {}

	StopAnimations()
	CurrentTool = nil
	WeaponConfig = nil
	IsSwinging = false
	CurrentAttackName = nil
end

Character.ChildAdded:Connect(function(child)
	if child:IsA("Tool") then OnEquip(child) end
end)

Character.ChildRemoved:Connect(function(child)
	if child:IsA("Tool") and child == CurrentTool then OnUnequip() end
end)
